# Copy this file to ".env.local" and fill in your own values.
# ".env.local" is ignored by Git, so your values never end up on GitHub.
#
# Leave these empty to run the app local-only (no sync).

# Supabase → your project → "Connect" (or Settings → API Keys)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The *publishable* key (starts with sb_publishable_). Never put the secret key here.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
